<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.template.ui.ReportController"
            style="-fx-background-color: #0e0b16; -fx-font-family: 'Verdana';">

    <!-- HEADER -->
    <top>
        <HBox style="-fx-background-color: #6a0572; -fx-padding: 20;" alignment="CENTER_LEFT">
            <Label text="📊 GENERATE REPORTS"
                   style="-fx-text-fill: #ff6f61; -fx-font-size: 26px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <!-- CENTER AREA -->
    <center>
        <VBox spacing="25" style="-fx-padding: 25;">

            <!-- Table with Label -->
            <Label text="Report Data"
                   style="-fx-text-fill: #f3eac2; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <TableView fx:id="reportTable"
                       prefHeight="400"
                       style="-fx-background-color: #1b1b2f;
                              -fx-control-inner-background: #241f3a;
                              -fx-table-cell-border-color: #6a0572;
                              -fx-font-size: 14px;
                              -fx-font-family: 'Verdana';">
                <columns>
                    <TableColumn fx:id="reportIdColumn" text="ID" prefWidth="80"/>
                    <TableColumn fx:id="reportNameColumn" text="Name" prefWidth="160"/>
                    <TableColumn fx:id="reportProgrammeColumn" text="Programme" prefWidth="130"/>
                    <TableColumn fx:id="reportLevelColumn" text="Level" prefWidth="80"/>
                    <TableColumn fx:id="reportGpaColumn" text="GPA" prefWidth="80"/>
                    <TableColumn fx:id="reportStatusColumn" text="Status" prefWidth="100"/>
                </columns>
            </TableView>

            <!-- Buttons arranged horizontally below the table -->
            <HBox spacing="20" alignment="CENTER" style="-fx-padding: 10;">
                <Button text="Import CSV"
                        fx:id="importCsvButton"
                        onAction="#importCsv"
                        style="-fx-background-color: #08d9d6;
                               -fx-text-fill: #0e0b16;
                               -fx-font-size: 16px;
                               -fx-font-weight: bold;
                               -fx-padding: 12 24;
                               -fx-background-radius: 20;"/>
                <Button text="Export CSV"
                        fx:id="exportCsvButton"
                        onAction="#exportCsv"
                        style="-fx-background-color: #ffbe0b;
                               -fx-text-fill: #0e0b16;
                               -fx-font-size: 16px;
                               -fx-font-weight: bold;
                               -fx-padding: 12 24;
                               -fx-background-radius: 20;"/>
            </HBox>

        </VBox>
    </center>

</BorderPane>